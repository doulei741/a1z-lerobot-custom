# Existing checkout and robot runtime. The defaults are auto-detected when possible.
A1Z_PROJECT_ROOT=/path/to/a1z-lerobot
A1Z_CONDA_ENV=lerobot-a1z

# Safe defaults: Mock on, all real hardware motion denied.
A1Z_WEB_MOCK=1
A1Z_WEB_ALLOW_HARDWARE=0

# Runtime persistence. Relative paths are resolved by the process working directory.
A1Z_WEB_DATA_DIR=./.runtime
LOG_DIR=./.runtime/logs
DATABASE_PATH=./.runtime/tasks.sqlite3
CORS_ORIGINS=http://localhost:5173

# Frontend optional override. Empty uses the current browser origin and Vite proxy.
VITE_API_BASE_URL=
